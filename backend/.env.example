# ============================================================
# VaultGuard Backend – Environment Configuration Template
# Copy this file to .env and fill in actual values.
# .env is gitignored and must NEVER be committed.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- MySQL 8 Database ---
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_mysql_username
DATABASE_PASSWORD=your_mysql_password
DATABASE_NAME=vaultguard_db

# --- Prisma Database URL (constructed from the values above) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://your_mysql_username:your_mysql_password@localhost:3306/vaultguard_db"

# --- Authentication & JWT Security ---
# Secret must be at least 32 cryptographically random bytes (e.g. 64-character hex)
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_bytes_long
JWT_EXPIRES_IN=15m

# --- Phase 6: Session & Cookie Notes ---
# Refresh tokens are stored as SHA-256 hashes in the database (no separate secret needed).
# Refresh token cookie: vg_refresh_token (HttpOnly, Secure in production, Path=/api/auth)
# CSRF mitigation: X-VaultGuard-Request: 1 header + Origin header matching FRONTEND_URL
